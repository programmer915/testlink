rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---- helpers ---------------------------------------------------
    function isOwner(testId) {
      return request.auth != null
        && request.auth.uid == get(/databases/$(database)/documents/tests/$(testId)).data.ownerId;
    }

    // The deterministic class-roster doc ID: one roster per (teacher,
    // class name), shared by every test that teacher assigns to that
    // class — computed the same way here and in index.html's
    // rosterIdFor(), so no query/lookup is ever needed to find it.
    function rosterId(ownerId, className) {
      return ownerId + '__' + className;
    }
    // A test with no assignedClass, or a class with no (or an empty)
    // roster uploaded yet, has nothing to validate against — those tests
    // keep the original open-registration behavior.
    function rosterIsActive(ownerId, className) {
      return className != null && className != ''
        && exists(/databases/$(database)/documents/classRosters/$(rosterId(ownerId, className)))
        && get(/databases/$(database)/documents/classRosters/$(rosterId(ownerId, className))).data.studentCount > 0;
    }
    // True once a roster IS active for this test's class AND the given
    // mobile key + student fields match that roster's registered record
    // for that mobile number exactly. index.html only ever writes the
    // roster's own canonical name/class/roll into the attempt/claim (see
    // submitDetails()), so a legitimate client always satisfies this
    // trivially; a hand-crafted write still has to already know the
    // correct registered name/class/roll for that exact mobile number to
    // pass — this narrows misuse, it doesn't require phone verification.
    function matchesRoster(ownerId, className, mobileKey, student) {
      let rid = rosterId(ownerId, className);
      return exists(/databases/$(database)/documents/classRosters/$(rid)/students/$(mobileKey)) &&
        studentFieldsMatch(rid, mobileKey, student);
    }
    function studentFieldsMatch(rid, mobileKey, student) {
      let sdoc = get(/databases/$(database)/documents/classRosters/$(rid)/students/$(mobileKey)).data;
      return student.mobile == mobileKey
        && student.normalizedName == sdoc.normalizedName
        && student.class == sdoc.class
        && (sdoc.roll == '' || student.roll == sdoc.roll);
    }
    // Combines the two: only enforced when a class is assigned AND that
    // class actually has an uploaded roster; otherwise this is a no-op
    // (true) so older tests / classes without a list keep working exactly
    // as before.
    function classListOk(test, mobileKey, student) {
      let className = ('meta' in test) && ('assignedClass' in test.meta) ? test.meta.assignedClass : '';
      return !rosterIsActive(test.ownerId, className)
        || matchesRoster(test.ownerId, className, mobileKey, student);
    }

    // Validates a brand-new attempt document against the test's actual
    // rules — this is the only thing standing between a student and just
    // writing themselves unlimited time, since there's no Cloud Function
    // here to check it in application code. Also bounds the shape/size of
    // every field a stranger's browser controls (name, roll, mobile, the
    // answers/marked maps, question-order arrays): index.html's own UI
    // never produces anything outside these bounds, so this only ever
    // rejects a hand-crafted write that skips the app entirely and calls
    // Firestore directly — it costs legitimate students nothing.
    function canCreateAttempt(testId, d) {
      let test = get(/databases/$(database)/documents/tests/$(testId)).data;
      return test.status == 'published'
        && d.testId == testId
        && d.status == 'in-progress'
        && d.answers is map && d.answers.size() == 0
        && d.marked is map && d.marked.size() == 0
        && d.tabSwitches == 0
        && d.currentIdx == 0
        && d.order is list && d.order.size() == test.questions.size()
        && d.optOrder is map && d.optOrder.size() == test.questions.size()
        && d.student is map
        && d.student.name is string && d.student.name.size() <= 200
        && d.student.class is string && d.student.class.size() <= 50
        && d.student.roll is string && d.student.roll.size() <= 50
        && d.student.mobile is string && d.student.mobile.size() <= 20
        && d.student.normalizedName is string && d.student.normalizedName.size() <= 200
        && d.mobileKey is string && d.mobileKey.size() <= 20
        // startedAt must be (approximately) now — a student can't backdate
        // it to manufacture extra elapsed time, nor postdate it to delay
        // when their timer starts counting down.
        && math.abs(request.time.toMillis() - d.startedAt) < 15000
        // availableMs can never exceed what the test's own config allows,
        // regardless of what value the client tries to send.
        && d.availableMs <= test.config.duration * 60000 + 1000
        && (test.config.deadlineAt == null
            || d.availableMs <= (test.config.deadlineAt - d.startedAt) + 15000)
        // Student must match this test's class list, if one is active.
        && classListOk(test, d.mobileKey, d.student);
    }

    // ---- tests -------------------------------------------------------
    match /tests/{testId} {
      // A specific test's document ID is enough to fetch it once
      // published (this is what makes the public share link and the
      // slug lookup work without being signed in) — get and list are
      // split so that "list" (querying the collection, rather than
      // fetching one known document) is bounded: a stranger can still
      // run the exact one-result-by-slug query the app itself uses
      // (status=='published' with a query limit of 1), but can no longer
      // enumerate every published test on this project in a single open
      // query, which would otherwise hand over every test's full
      // question bank — including embedded answer keys for
      // "immediate"/"score only" visibility tests — not just the one
      // test a given link was actually shared for.
      allow get: if resource.data.status == 'published'
                  || (request.auth != null && request.auth.uid == resource.data.ownerId);
      allow list: if (request.auth != null && request.auth.uid == resource.data.ownerId)
                  || (resource.data.status == 'published' && request.query.limit <= 1);
      allow create: if request.auth != null && request.auth.uid == request.resource.data.ownerId;
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.ownerId;

      // ---- attempts (the exam session itself) -------------------------
      // No Cloud Functions in this build, so these rules — not application
      // code — are what enforce the timer and stop a student from just
      // editing their own remaining time or answers directly in Firestore.
      match /attempts/{attemptId} {
        allow create: if canCreateAttempt(testId, request.resource.data);

        // A student who already knows this specific (effectively
        // unguessable, Firestore-auto-generated) attempt ID can fetch it
        // directly — this is what makes "resume after refresh / reopening
        // the link" work. It does NOT allow browsing/listing all attempts.
        allow get: if true;
        allow list: if isOwner(testId);

        allow update: if
          ( // the student's own progress/submit writes — time-boxed, core fields locked
            resource.data.status == 'in-progress' &&
            request.resource.data.testId == resource.data.testId &&
            request.resource.data.startedAt == resource.data.startedAt &&
            request.resource.data.availableMs == resource.data.availableMs &&
            request.resource.data.order == resource.data.order &&
            request.resource.data.optOrder == resource.data.optOrder &&
            request.resource.data.student == resource.data.student &&
            // Bounds on the fields a student's browser writes on every
            // progress sync/submit — generous enough that no real exam
            // ever approaches them, tight enough to stop a direct-API
            // write from padding an attempt with junk data.
            request.resource.data.answers is map &&
            request.resource.data.answers.size() <= 500 &&
            request.resource.data.marked is map &&
            request.resource.data.marked.size() <= 500 &&
            request.resource.data.tabSwitches is int &&
            request.resource.data.tabSwitches >= 0 &&
            request.resource.data.currentIdx is int &&
            (!('heartbeatAt' in request.resource.data) || request.resource.data.heartbeatAt is timestamp) &&
            // Every save — including the final submit — has to arrive within
            // the real allowance plus a short grace period for normal network
            // latency. This is checked against request.time, Firestore's own
            // clock, so changing a device's system clock has no effect on it.
            request.time.toMillis() <= resource.data.startedAt + resource.data.availableMs + 60000
          ) || (
            // the teacher's own "Reset/Allow Retry" action — no time limit,
            // and deliberately allowed even on an already-expired attempt.
            // It can only ever flip a non-submitted attempt to 'invalidated'
            // (never edit its answers or resurrect a submitted one), which
            // is what lets the old record be kept instead of deleted.
            isOwner(testId) &&
            resource.data.status != 'submitted' &&
            request.resource.data.status == 'invalidated'
          );

        // Only the owning teacher can delete an attempt — this is the
        // "remove a wrong/duplicate submission" tool in the Results view.
        // Students can never delete anything, including their own attempt.
        allow delete: if isOwner(testId);
      }

      // ---- mobile-number attempt limiting ------------------------------
      // One document per (test, mobile number), holding a count. The
      // client always writes with FieldValue.increment(1) and never reads
      // first — Firestore resolves that against a missing field as 0, so
      // the very first attempt is naturally a "create" with count 1, and
      // every attempt after is an "update" with count = previous + 1. The
      // rule simply refuses to let count exceed the test's own configured
      // attempt limit, so "Allowed attempts per student" in Configure is
      // now the real, enforced number — not just a label.
      match /mobileClaims/{mobileKey} {
        allow create: if
          get(/databases/$(database)/documents/tests/$(testId)).data.status == 'published' &&
          request.resource.data.count <= get(/databases/$(database)/documents/tests/$(testId)).data.config.attempts &&
          request.resource.data.student is map &&
          request.resource.data.student.name is string && request.resource.data.student.name.size() <= 200 &&
          request.resource.data.student.class is string && request.resource.data.student.class.size() <= 50 &&
          request.resource.data.student.roll is string && request.resource.data.student.roll.size() <= 50 &&
          request.resource.data.student.mobile is string && request.resource.data.student.mobile.size() <= 20 &&
          classListOk(get(/databases/$(database)/documents/tests/$(testId)).data, mobileKey, request.resource.data.student);
        allow update: if
          get(/databases/$(database)/documents/tests/$(testId)).data.status == 'published' &&
          request.resource.data.count == resource.data.count + 1 &&
          request.resource.data.count <= get(/databases/$(database)/documents/tests/$(testId)).data.config.attempts;
        allow get, list, delete: if isOwner(testId);
      }

      // ---- private answer key (only for "hidden" result-visibility tests) --
      // Used only when a test's resultVisibility is 'hidden' — see saveTest()
      // in index.html. For 'immediate'/'scoreOnly' tests, the answer key
      // travels with the public test document instead (the tradeoff already
      // documented below), and this subcollection is simply never written.
      match /private/{doc} {
        allow read, write: if isOwner(testId);
      }
    }

    match /questionBank/{itemId} {
      // Each teacher's saved questions are entirely private to them.
      allow read, update, delete: if request.auth != null && request.auth.uid == resource.data.ownerId;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.ownerId;
    }

    // ---- class rosters (Classes tab / class list) ---------------------
    // One roster doc per (teacher, class name), ID = rosterId() above; a
    // students subcollection underneath holds one small doc per student,
    // keyed by their own canonical 10-digit mobile number. Never one big
    // spreadsheet-shaped document — each student doc stays tiny regardless
    // of class size, so Firestore's 1MiB/doc cap never applies here, and a
    // roster update only ever touches the specific student docs changed.
    match /classRosters/{rosterId} {
      // The roster doc's own fields (className, studentCount, ownerId,
      // updatedAt) hold no student PII — get is public so a student's
      // browser can cheaply check "does a roster exist for my class, and
      // is it actually populated" (see rosterIsActive()) before validating
      // an individual mobile number below. Listing every roster (which
      // would expose other teachers' class names) stays owner-only.
      allow get: if true;
      allow list: if request.auth != null && resource.data.ownerId == request.auth.uid;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.ownerId;
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.ownerId;

      match /students/{mobileKey} {
        // A specific student record is readable by anyone who already
        // knows that exact 10-digit mobile number and the roster it
        // belongs to (mirrors the attempts/{attemptId} "get open, list
        // owner-only" pattern) — this is what lets a student's own browser
        // validate itself in submitDetails() without being signed in, and
        // is exactly the same "must already know the specific key" limit
        // documented for mobileClaims above. Listing (enumerating every
        // registered student and their name/roll) stays owner-only.
        //
        // Every check below guards with exists() on the roster PARENT doc
        // first: a class the teacher has never imported a list for (or is
        // importing into for the very first time) has no classRosters/{id}
        // doc yet, and get(...).data on a nonexistent doc throws inside a
        // rule rather than evaluating to false — without this guard, just
        // opening a brand-new class's page (a list query) or running its
        // first-ever import (a write) would fail with a raw
        // "Missing or insufficient permissions" instead of working.
        allow get: if true;
        allow list: if request.auth != null && (
          !exists(/databases/$(database)/documents/classRosters/$(rosterId)) ||
          get(/databases/$(database)/documents/classRosters/$(rosterId)).data.ownerId == request.auth.uid
        );
        // create/update (not delete — request.resource doesn't exist on a
        // delete, so field checks can't apply there) get the same kind of
        // size/type bounds as the public-facing writes above, even though
        // this path is already owner-only: cheap insurance against a
        // malformed import (e.g. a spreadsheet cell that somehow contains
        // megabytes of text) silently writing an oversized document.
        allow create, update: if request.auth != null &&
          exists(/databases/$(database)/documents/classRosters/$(rosterId)) &&
          get(/databases/$(database)/documents/classRosters/$(rosterId)).data.ownerId == request.auth.uid &&
          request.resource.data.name is string && request.resource.data.name.size() <= 200 &&
          request.resource.data.roll is string && request.resource.data.roll.size() <= 50 &&
          request.resource.data.class is string && request.resource.data.class.size() <= 50;
        allow delete: if request.auth != null &&
          exists(/databases/$(database)/documents/classRosters/$(rosterId)) &&
          get(/databases/$(database)/documents/classRosters/$(rosterId)).data.ownerId == request.auth.uid;
      }
    }
  }
}

/*
  Architecture note (free Spark plan — no Cloud Functions, no billing
  account required anywhere):

  Answer-key handling is now per-test, controlled by the existing "Result
  visibility" setting in Configure:

    - "Show immediately" / "Score only" — the answer key travels inside
      the public test document, so a student's own browser can grade
      their exam instantly on submit. The cost: a technically curious
      student could find the answer key via developer tools. This is the
      original tradeoff for this build, kept for tests where instant
      feedback matters more than key secrecy.

    - "Hidden until released" — saveTest() strips `correct` out of the
      published test entirely and stores it in tests/{id}/private/
      answerKey instead, which only the owning teacher can ever read.
      A student's browser submits raw answers only; grading happens
      later, in the teacher's own authenticated session, the moment they
      open the Results page (see gradeAttempt()/subscribeResults() in
      index.html). The student's browser never has the key, before,
      during, or after the exam — full secrecy, at the cost of the
      student not seeing a score at all until the teacher looks.

  What these rules still genuinely enforce, with no server code at all:
    - A teacher can only ever read/write their own tests, question bank,
      and answer keys (not other teachers').
    - An exam's timer can't be extended by editing a device's clock: every
      write to an attempt — including the final submission — is checked
      against Firestore's own request.time, not anything the client sends.
    - A fresh attempt's time allowance is capped at what the test's actual
      duration/deadline permit, no matter what a client tries to write.
    - Once an attempt is submitted, no one but the owning teacher can
      modify or remove it — students can never edit or delete anything.
    - A student can fetch (resume) only a specific attempt they already
      know the ID of; they cannot list or browse other students' attempts.
      Only the owning teacher can list all attempts for a test.
    - Each mobile number gets up to the test's own "Allowed attempts per
      student" limit (set in Configure), enforced atomically by an
      incrementing counter rather than a query. A determined student can
      still type a fake number, since there's no SMS/OTP verification
      here — this stops accidental/casual re-attempts, not a deliberately
      dishonest one. The teacher's "Remove" button (on a submitted
      result) and "Release a mobile number" tool (for a stuck,
      never-submitted attempt) both clear the claim so a genuine retry is
      always possible, on top of whatever attempts remained.
    - When a test's class has an uploaded, non-empty class list, both the
      attempt and its mobile-number claim are rejected server-side unless
      the submitted mobile number, case/space-normalized name, class, and
      (where the roster has one) roll number all match that class list's
      registered record for that exact mobile number — see classListOk()
      above. A class with no list uploaded yet (or a test with no class
      assigned at all) is left exactly as open as before. As with the
      mobile-claim limit above, this narrows misuse rather than
      eliminating it: since there's no phone verification, anyone who can
      read a specific mobile number's roster entry (which the "get" rule
      on classRosters/.../students necessarily allows, mirroring the
      attempts pattern) could in principle copy its exact fields — it
      stops accidental wrong-name/wrong-class entries and casual
      impersonation, not a determined, informed attacker.
    - A stranger can fetch one specific published test by its document ID
      (needed for the share link), but can no longer run an open query
      across the whole tests collection to enumerate every published test
      on the project — list is only allowed for the owner, or for the
      exact one-result-by-slug query the app itself uses. Without this,
      anyone with the page's already-public Firebase config (see
      note below) could have pulled every test's full question bank —
      including embedded answer keys on "immediate"/"score only" tests —
      straight out of the browser console, not just the one test a given
      link was actually shared for.
    - Every field a stranger's browser controls (student name/class/roll/
      mobile, the answers/marked maps, the question-order arrays) is
      bounded in size and type at write time — generous enough that
      nothing in index.html's own UI ever approaches the limits, tight
      enough that a hand-crafted write bypassing the app entirely (calling
      Firestore straight from a browser console) can't pad an attempt or
      a roster entry with megabytes of junk data.

  A note on the Firebase web config (apiKey, authDomain, etc.) in
  index.html: this is not a secret the way a server API key or a
  database password is. It only tells Google's servers which project to
  route a request to — it grants no access on its own. Every Firebase
  web app necessarily ships this in the browser bundle; hiding the
  GitHub repo wouldn't hide it either, since anyone can already read it
  via "View Source" on the deployed site. The rules above — not the
  key's secrecy — are what actually gate who can read or write data.
  Two things worth doing once, outside this file, in the Google Cloud
  Console: (1) restrict the key itself (APIs & Services → Credentials)
  to an HTTP-referrer allowlist for your deployed domain, and to only
  the Identity Toolkit/Firebase APIs it actually needs, so it can't be
  reused against other Google APIs on the same project; (2) if you don't
  want strangers creating teacher accounts, disable public sign-up (or
  switch to invite-only) in Authentication → Sign-in method.

  If the answer-key tradeoff on "immediate"/"score only" tests ever needs
  closing too, the fix is a Cloud Function that grades everything
  server-side regardless of visibility setting — already built once for
  this project, at the cost of Firebase requiring a billing method on
  file (Blaze plan; still $0 at classroom scale). Ask if you want it back.
*/
